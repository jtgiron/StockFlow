# Database connection string (PostgreSQL)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# JWT secret key — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# Token expiry (optional, defaults shown)
JWT_ACCESS_EXPIRY=1h
JWT_REFRESH_EXPIRY=7d

# Client URL for CORS (production)
CLIENT_URL=http://localhost:5173

# Local password reset code expiry (minutes)
LOCAL_PASSWORD_RESET_TTL_MINUTES=15

# Node environment: development | production
NODE_ENV=development

# Server port
PORT=3000

# Mercado Pago integration (required together when enabling MP OAuth/connect flow)
MP_CLIENT_ID=
MP_CLIENT_SECRET=
MP_REDIRECT_URI=http://localhost:3000/api/mp/oauth/callback
MP_NOTIFICATION_URL=
MP_WEBHOOK_SECRET=
MP_SPONSOR_ID=
MP_ORDER_TIMEOUT_MINUTES=15

# ARCA / WSFE electronic invoicing
ARCA_CUIT=
ARCA_CERT_PEM=
ARCA_PRIVATE_KEY=
ARCA_PTO_VENTA=
ARCA_ENV=homo
